 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Kokoro TTS Android - Cloud Compiler\n",
    "Run this notebook in **Google Colab** to build the Kokoro TTS APK in ~2 minutes."
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Step 1: Install OpenJDK 17 & Android SDK"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 1. Install JDK 17\n",
    "!apt-get update -qq && apt-get install -y -qq openjdk-17-jdk\n",
    "\n",
    "# 2. Install Android Command-Line Tools & SDK 34\n",
    "!mkdir -p /root/Android/Sdk/cmdline-tools\n",
    "!cd /root/Android/Sdk/cmdline-tools && \\\n",
    "  curl -s -O https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip && \\\n",
    "  unzip -q -o commandlinetools-linux-*.zip && \\\n",
    "  rm -f commandlinetools-linux-*.zip && \\\n",
    "  rm -rf latest && \\\n",
    "  mv cmdline-tools latest\n",
    "\n",
    "# 3. Accept Android Licenses and install platforms\n",
    "!yes | /root/Android/Sdk/cmdline-tools/latest/bin/sdkmanager --licenses > /dev/null\n",
    "!/root/Android/Sdk/cmdline-tools/latest/bin/sdkmanager \"platform-tools\" \"platforms;android-34\" \"build-tools;34.0.0\" > /dev/null\n",
    "print(\"✅ Android SDK 34 is successfully installed!\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Step 2: Upload KokoroTTS-Android.zip"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "from google.colab import files\n",
    "\n",
    "if not os.path.exists(\"/content/KokoroTTS-Android.zip\"):\n",
    "    print(\"Please upload your KokoroTTS-Android.zip file:\")\n",
    "    uploaded = files.upload()\n",
    "else:\n",
    "    print(\"✅ KokoroTTS-Android.zip is already present in /content/\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Step 3: Unpack and Compile the APK"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "%cd /content\n",
    "!rm -rf project && mkdir project\n",
    "!unzip -q -o KokoroTTS-Android.zip -d project\n",
    "!echo \"sdk.dir=/root/Android/Sdk\" > project/local.properties\n",
    "!chmod +x project/gradlew\n",
    "\n",
    "%cd /content/project\n",
    "# Run assembleDebug (this compiles the arm64-v8a APK)\n",
    "!export JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64 && ./gradlew assembleDebug\n",
    "\n",
    "# Copy generated APKs to /content for easy access\n",
    "!cp /content/project/app/build/outputs/apk/debug/*.apk /content/ 2>/dev/null || true\n",
    "\n",
    "import glob\n",
    "apks = glob.glob('/content/*.apk')\n",
    "if apks:\n",
    "    print(\"\\n🎉 SUCCESS! Generated APK(s):\")\n",
    "    for a in apks:\n",
    "        print(f\"  -> {a} ({os.path.getsize(a) / (1024*1024):.1f} MB)\")\n",
    "else:\n",
    "    print(\"\\n❌ Build did not produce an APK. Check the log above for errors.\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Step 4: Download the Generated APK"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import glob\n",
    "from google.colab import files\n",
    "\n",
    "apks = glob.glob(\"/content/*.apk\")\n",
    "if apks:\n",
    "    for apk in apks:\n",
    "        print(f\"Downloading {apk} to your computer...\")\n",
    "        files.download(apk)\n",
    "    print(\"\\nIf your browser blocks the automatic download popup:\")\n",
    "    print(\"Click the 📁 Files icon on the left sidebar in Colab, find the .apk file, click the 3 dots, and select 'Download'!\")\n",
    "else:\n",
    "    print(\"No APK files found to download. Please run Step 3 successfully first.\")"
   ]
  }
 ]
}
